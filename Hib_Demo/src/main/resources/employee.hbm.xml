<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC 
"-//Hibernate/Hibernate Mapping DTD//EN"
"http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
<class name="org.dcl.hib.Employee" table="Employee">

<id name="id" column="id">
<generator class="identity"></generator>
</id>

<property name="name" column="ename" not-null="true" />
<property name="phone" column="phone" not-null="true" unique="true" />
<property name="desg" column="desg" not-null="true" />
<property name="salary" column="salary" not-null="true" />
<property name="email" column="email" not-null="true" unique="true" />
<property name="password" column="password" not-null="true" />

</class>
</hibernate-mapping>